# Copy to .env and fill in. Never commit .env.
# BUILD_SPEC section 11 is the list of record.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Worker only. Bypasses RLS. Never ship this to the app or the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server side only, never client side.
ANTHROPIC_API_KEY=

# Delivery (Phase 3)
# Use a separate dev bot locally. Two long pollers on one token throw 409s and
# fight forever, which is exactly what happens the first time local dev runs
# while Railway is deployed. See ben/TELEGRAM_SETUP.md.
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=
RESEND_FROM=

# Where digest deep links point. Must be the deployed app in production, or the
# links in a real digest go to localhost.
APP_URL=http://localhost:3100

# Optional. Routes every seeded tenant's email digest to one inbox so the email
# path can be tested without putting real partner addresses in this repo.
DIGEST_TEST_EMAIL=

# Action layer (Phase 4)
LOB_API_KEY=

# Billing (Phase 6)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Only needed if the worker moves from node-cron to BullMQ.
REDIS_URL=

# Optional. Some Socrata endpoints rate limit harder without a token.
SOCRATA_APP_TOKEN=

# Used only by the RLS test suite. Point these at a scratch project or a local
# supabase start instance, never at production.
RLS_TEST_SUPABASE_URL=
RLS_TEST_SERVICE_ROLE_KEY=
RLS_TEST_ANON_KEY=
