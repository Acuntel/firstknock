# Copy to .env and fill in. Never commit .env.
# BUILD_SPEC section 11 is the list of record.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Worker only. Bypasses RLS. Never ship this to the app or the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server side only, never client side.
ANTHROPIC_API_KEY=

# Delivery (Phase 3)
#
# There are two bots, and which token goes where is not interchangeable.
#
#   local .env  ->  @firstNtwo_bot          the dev bot
#   Railway     ->  @firstknock_leads_bot   the one that messages real clients
#
# Two reasons this matters. Two long pollers on one token throw 409 conflicts
# that do not resolve on their own, so a local run and a deployed worker sharing
# a token will fight. And a local test using the production token can send a
# digest to Paul or Vince, which is a mistake you only get to make once.
#
# The production token is deliberately not in this file or anywhere in the repo.
# It belongs in the Railway dashboard at deploy time.
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=
RESEND_FROM=

# Where digest deep links point. Must be the deployed app in production, or the
# links in a real digest go to localhost.
APP_URL=http://localhost:3100

# Optional. Routes every seeded tenant's email digest to one inbox so the email
# path can be tested without putting real partner addresses in this repo.
DIGEST_TEST_EMAIL=

# Action layer (Phase 4)
LOB_API_KEY=

# Billing (Phase 6)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Only needed if the worker moves from node-cron to BullMQ.
REDIS_URL=

# Optional. Some Socrata endpoints rate limit harder without a token.
SOCRATA_APP_TOKEN=

# Used only by the RLS test suite. Point these at a scratch project or a local
# supabase start instance, never at production.
RLS_TEST_SUPABASE_URL=
RLS_TEST_SERVICE_ROLE_KEY=
RLS_TEST_ANON_KEY=

# Telegram chats that run FirstKnock rather than buy from it. /leads answers
# across every market for these, instead of for one connected county.
OPERATOR_CHAT_IDS=

# Prospecting. The bot writes drafts to your own mailbox and never sends, so
# this is an app specific password, never the account password. iCloud issues
# them at appleid.apple.com, Google at myaccount.google.com/apppasswords.
MAIL_USER=
MAIL_APP_PASSWORD=
# Only needed for a custom domain, where the address does not name the host.
# iCloud custom domains use imap.mail.me.com.
MAIL_IMAP_HOST=
PROSPECT_SENDER_NAME=
# Commercial email in the United States has to carry a real postal address.
PROSPECT_POSTAL_ADDRESS=

# Who may see the prospect list in the app. Empty grants nobody.
OPERATOR_EMAILS=

# Optional. With a number the outreach says call me, without it, reply and we
# will set up a call.
PROSPECT_PHONE=
