{
  "name": "@firstknock/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "comment": "Exports point at TypeScript source. The app compiles them through next.config transpilePackages, so there is no build step to keep in sync.",
  "exports": {
    "./types": "./src/types.ts",
    "./scoring": "./src/scoring/score.ts",
    "./scoring/types": "./src/scoring/types.ts",
    "./scoring/presets": "./src/scoring/presets.ts",
    "./tenants": "./src/tenants.ts",
    "./adapters/cook-socrata": "./src/adapters/cook-socrata.ts",
    "./fixtures/cook-sales.json": "./fixtures/cook-sales.json",
    "./fixtures/cook-permits.json": "./fixtures/cook-permits.json",
    "./format": "./src/format.ts",
    "./counties": "./src/counties.ts",
    "./lead-id": "./src/lead-id.ts",
    "./plural": "./src/plural.ts",
    "./digest/schedule": "./src/digest/schedule.ts",
    "./digest/compose": "./src/digest/compose.ts",
    "./event-row": "./src/event-row.ts",
    "./registry": "./src/registry.ts",
    "./billing/plans": "./src/billing/plans.ts",
    "./telegram/connect": "./src/telegram/connect.ts",
    "./prospect/buyers": "./src/prospect/buyers.ts",
    "./prospect/mail-draft": "./src/prospect/mail-draft.ts",
    "./prospect/market-stats": "./src/prospect/market-stats.ts",
    "./prospect/pitch": "./src/prospect/pitch.ts",
    "./prospect/store": "./src/prospect/store.ts",
    "./prospect/import": "./src/prospect/import.ts",
    "./prospect/match": "./src/prospect/match.ts",
    "./prospect/batch": "./src/prospect/batch.ts"
  },
  "scripts": {
    "once": "tsx src/run-once.ts",
    "seed-sources": "tsx src/seed-sources.ts",
    "seed-tenants": "tsx src/seed-tenants.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "delivery": "tsx src/run-delivery.ts",
    "bot": "tsx src/run-bot.ts",
    "digest:preview": "tsx src/preview-digest.ts",
    "telegram:check": "tsx src/telegram-check.ts",
    "digest:send-test": "tsx src/send-test-digest.ts",
    "telegram:setup": "tsx src/telegram-setup.ts",
    "score": "tsx src/run-pipeline.ts",
    "cron": "tsx src/run-cron.ts",
    "invite": "tsx src/invite.ts",
    "connect": "tsx src/connect-telegram.ts",
    "prospect": "tsx src/run-prospect.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@supabase/supabase-js": "^2.47.10",
    "dotenv": "^16.4.7",
    "grammy": "^1.45.1",
    "imapflow": "^1.6.6",
    "mailparser": "^3.9.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
