{
  "name": "firstknock",
  "version": "0.1.0",
  "private": true,
  "description": "Know first. Knock first. County public records to scored leads.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "worker:once": "pnpm --filter @firstknock/worker run once",
    "worker:seed-sources": "pnpm --filter @firstknock/worker run seed-sources",
    "worker:seed-tenants": "pnpm --filter @firstknock/worker run seed-tenants",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "worker:delivery": "pnpm --filter @firstknock/worker run delivery",
    "worker:bot": "pnpm --filter @firstknock/worker run bot",
    "digest:preview": "pnpm --filter @firstknock/worker run digest:preview",
    "telegram:check": "pnpm --filter @firstknock/worker run telegram:check",
    "digest:send-test": "pnpm --filter @firstknock/worker run digest:send-test",
    "telegram:setup": "pnpm --filter @firstknock/worker run telegram:setup",
    "worker:score": "pnpm --filter @firstknock/worker run score"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@11.21.0"
}
